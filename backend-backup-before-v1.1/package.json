{
  "name": "tsm-backend",
  "version": "0.1.0",
  "private": true,
  "description": "TSM (The Sealed Market) API: Express + MySQL",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "init-env": "node scripts/init-env.js",
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "NODE_ENV=test node --test --test-concurrency=1 test/*.test.js",
    "db:load-test": "NODE_ENV=test node scripts/load-test-db.js",
    "create-staff": "node scripts/create-staff.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.6",
    "zod": "^4.6.7"
  }
}
