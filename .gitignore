# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
__MACOSX/

# Xcode: personal window state and build output (the project file itself stays)
xcuserdata/
*.xcuserstate
DerivedData/
build/
.build/
.swiftpm/
*.xcarchive
*.ipa
*.dSYM
*.dSYM.zip

# Secrets and local settings (the .example files stay)
.env
.env.*
!.env.example

# Node
node_modules/
dist/
.vite/
coverage/
.nyc_output/
*.log
npm-debug.log*

# Files the running backend creates (product photos, seller documents)
backend/storage/

# Safety copies and leftovers
*-backup-*/
*.backup
*.backup-*
*.bak
*.orig
*.rej
*.swp
*~

# Database dumps
*.dump
*.sql.gz

# Test output
test-results/
playwright-report/

# Editors
.idea/
.vscode/

# db/ has no package.json, so this lockfile is a stray stub
db/package-lock.json