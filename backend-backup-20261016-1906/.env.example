# Copy to .env with:  npm run init-env     (it also fills in the two secrets below)
# Never commit .env

NODE_ENV=development
PORT=4000

# App database (created by db/sql/00_create_database_and_user.sql)
DATABASE_URL="mysql://tsm_app:rootroot@127.0.0.1:3306/tsm"
# Used only by "npm test". The tests wipe and rebuild this database - its name MUST end in _test.
TEST_DATABASE_URL="mysql://tsm_app:rootroot@127.0.0.1:3306/tsm_test"

# Long random values, one per login population. "npm run init-env" generates them.
JWT_SECRET_USER=replace-me
JWT_SECRET_STAFF=replace-me-too

# bcrypt work factor for password hashing (higher = slower and safer)
BCRYPT_ROUNDS=12

# Link written into password-reset emails; the iOS app opens it via its tsm:// URL scheme
PASSWORD_RESET_LINK_BASE=tsm://reset-password

# Origins allowed to call the API from a browser (the React admin's dev server)
CORS_ORIGINS=http://localhost:5173

# Demo-only shortcut: a seller application whose source type is "test" approves itself (no documents, no review).
# MUST be false anywhere that is not your own machine; the server refuses to start in production if true.
ALLOW_TEST_SELLER_AUTOAPPROVE=true

# Where uploaded seller-application documents are stored. Optional; the default is backend/storage.
# UPLOAD_DIR=/Users/you/School/backend/storage

# TSM's commission on each sale, in basis points (300 = 3.00%). Optional; default 300.
# COMMISSION_BPS=300
