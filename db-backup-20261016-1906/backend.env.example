# Copy to backend/.env  (never commit the real .env)

NODE_ENV=development
PORT=4000

# App database (created by sql/00_create_database_and_user.sql)
DATABASE_URL="mysql://tsm_app:rootroot@127.0.0.1:3306/tsm"
# Used only by automated tests; the test run wipes this database
TEST_DATABASE_URL="mysql://tsm_app:rootroot@127.0.0.1:3306/tsm_test"

# Generate two different long random values:  openssl rand -base64 48
JWT_SECRET_USER=replace-me
JWT_SECRET_STAFF=replace-me-with-a-different-one

# Demo-only shortcut: lets applications containing "test" auto-approve.
# MUST be false anywhere that is not your own machine.
ALLOW_TEST_SELLER_AUTOAPPROVE=true
